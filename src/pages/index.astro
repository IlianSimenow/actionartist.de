---
import Layout from '../layouts/Layout.astro';
import ContactInfo from '../components/ContactInfo.astro';
---

<Layout lang="de" title="Ilian Simeonow — Stuntman & Artist aus Dresden" description="Ilian Simeonow — Stuntman, Kaskadeur, Artist und Schauspieler aus Dresden. Über 23 Jahre Erfahrung in Film, Fernsehen, Theater und Show." showSedcardBar>

  <!-- ══ HERO ══ -->
  <section class="hero">
    <video
      class="hero-video"
      id="heroBgVideo"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/assets/video/hero-loop.webm" type="video/webm" />
      <source src="/assets/video/hero-loop.mp4"  type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>
    <div class="hero-grain"></div>
    <div class="hero-top-bar"></div>
    <div class="hero-left-rule"></div>

    <div class="hero-content">
      <div class="hero-eyebrow">Stuntman · Artist · Dresden, Deutschland</div>

      <h1 class="hero-name">
        ILIAN<br />
        <span class="hero-name-accent">SIMEONOW</span>
      </h1>

      <p class="hero-role">Kaskadeur · Action Artist · Schauspieler · Zauberer</p>

      <div class="hero-actions">
        <a href="/video/" class="btn-primary">Showreel ansehen</a>
        <a href="/credits/" class="btn-ghost">Credits &amp; Referenzen</a>
      </div>

    </div>

    <div class="hero-side-text">Stuntman · Kaskadeur · Action Artist · Schauspieler</div>
  </section>

  <!-- ══ SKILLS STRIP ══ -->
  <!-- skills carousel rendered via Layout on all routes -->

  <!-- ══ ABOUT ══ -->
  <section class="about-section">
    <div>
      <div class="section-label">// Über mich</div>
      <h2 class="section-heading">Kaskadeur<br />aus Leidenschaft.</h2>
      <p class="body-text">
        Sie sind auf der Suche nach einem Kampfchoreographen, Stuntkoordinator, Action-Darsteller, Stuntman, Komiker, Zauberer oder Artisten? Dann sind Sie hier genau richtig.
      </p>
      <p class="body-text" style="margin-top: 18px;">
        Seit über 23 Jahren steht Ilian Simeonow auf den internationalen Bühnen dieser Welt — von Norwegen bis nach Dubai.
      </p>
      <a href="/biographie/" class="link-more">Biographie lesen →</a>
    </div>
    <div class="photo-block" style="max-width: 50%; margin: 0 auto;">
      <img src="/images/portrait/Portr%C3%A4tfoto-3.jpg" alt="Ilian Simeonow — Stuntman & Artist" loading="lazy" />
      <div class="photo-caption">Stuntman · Dresden</div>
    </div>
  </section>

  <!-- ══ LETZTE PRODUKTIONEN ══ -->
  <section class="productions-section">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <div class="section-label">// Letzte Produktionen</div>
        <h2 class="section-heading">Aktuelles &amp;<br />Neuigkeiten.</h2>
      </div>
      <a href="/credits/" class="link-more" style="margin-top: 0;">Alle Credits ansehen →</a>
    </div>
    <div class="productions-list">
      <div class="production-item">
        <div class="production-year">2024</div>
        <div class="production-text">Karl-May Festival Radebeul &amp; Felsenbühne Rathen. Desweiteren wieder mit AWEGO auf der Jakubzburg in Mortka.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2023</div>
        <div class="production-text">Karl-May Festspiele mit Stuntteam Awego &amp; Jakubzburg in Mortka — "Die Töchter der Burg" (Rolle: Fou).</div>
      </div>
      <div class="production-item">
        <div class="production-year">2022</div>
        <div class="production-text">Semperoper Dresden — <em style="color: var(--white);">Der Wildschütz</em> (ab September).</div>
      </div>
      <div class="production-item">
        <div class="production-year">2020</div>
        <div class="production-text">Moderation Monstershow auf der Motorradmesse Dortmund. Globe of Speed-Auftritte. Ab März 2020 bis September 2022 Corona-bedingte Pause.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2019</div>
        <div class="production-text">Letzte Saison Eldorado Templin. Semperoper Dresden — <em style="color: var(--white);">Die Verkaufte Braut / Der Freischütz / Der Wildschütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2018</div>
        <div class="production-text">Berufscowboy in Templin. Semperoper Dresden — <em style="color: var(--white);">Der Freischütz / Der Wildschütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2017</div>
        <div class="production-text">Semperoper Dresden — <em style="color: var(--white);">Der Freischütz</em>. Beitritt ELDORADO Stuntteam Templin.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2016</div>
        <div class="production-text">Stuntkoordinator &amp; Kampfchoreograph — <em style="color: var(--white);">Das Vermächtnis (Müritz Saga)</em>, Waren a. d. Müritz. Semperoper Dresden — <em style="color: var(--white);">Der Wildschütz / Der Freischütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2015</div>
        <div class="production-text"><em style="color: var(--white);">Müritz Saga</em>, Waren a. d. Müritz — Rolle: Loddar. Semperoper Dresden — <em style="color: var(--white);">Der Freischütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2014</div>
        <div class="production-text">Open-Air-Theater <em style="color: var(--white);">1000 Jahre Brandenburg — Theatro Spectacula</em> — Rolle: Dietrich.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2013</div>
        <div class="production-text">Kinofilm <em style="color: var(--white);">La belle &amp; la bête</em> — Stuntdouble Nicolas Gob. Motorrad Messe Leipzig mit Globe of Speed.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2011</div>
        <div class="production-text">Letzter Auftritt im Piraten Open Air Theater Grevesmühlen — Rolle: Don Merdas. Globe of Speed u. a. Tuning World Bodensee. Kinofilm <em style="color: var(--white);">The Three Musketeers</em>.</div>
      </div>
    </div>
  </section>

