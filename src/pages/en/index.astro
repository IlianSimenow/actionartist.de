<style>
  .photo-block img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gallery-section .gallery-thumb {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }
  .gallery-section .gallery-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gallery-section .gallery-thumb:hover img {
    transform: scale(1.05);
  }
  .video-thumb {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }
  .video-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .video-thumb:hover img {
    transform: scale(1.03);
  }
  .credits-grid--weitere {
    grid-template-columns: repeat(4, 1fr);
  }
  .credit-card--tag {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--gray);
    text-align: center;
    min-height: 72px;
  }
</style>

<script>
  const vid = document.getElementById('heroBgVideo') as HTMLVideoElement | null;
  if (vid) {
    vid.addEventListener('canplaythrough', () => vid.classList.add('hero-video--loaded'));
    vid.addEventListener('error', () => vid.remove());
  }

  const tabs = document.querySelectorAll<HTMLElement>('.credits-tab[data-tab]');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab!;
      tabs.forEach(t => t.classList.remove('credits-tab--active'));
      tab.classList.add('credits-tab--active');
      document.querySelectorAll<HTMLElement>('[id^="tab-"]').forEach(panel => {
        panel.style.display = panel.id === `tab-${target}` ? '' : 'none';
      });
    });
  });
</script>
