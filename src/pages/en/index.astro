---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" title="Ilian Simeonow — Stuntman & Artist from Dresden" description="Ilian Simeonow — stuntman, stunt performer, artist and actor from Dresden. 23+ years in film, TV and theatre. Available for bookings.">

  <div class="sedcard-bar">
    <span class="sedcard-bar-text">Download Sedcard &amp; CV as PDF</span>
    <a href="/pdfs/setcard-en.pdf" download class="btn-outline-orange">↓ Sedcard &amp; CV PDF</a>
  </div>

  <section class="hero">
    <video class="hero-video" id="heroBgVideo" autoplay muted loop playsinline preload="auto">
      <source src="/assets/video/hero-loop.webm" type="video/webm" />
      <source src="/assets/video/hero-loop.mp4"  type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-grain"></div>
    <div class="hero-top-bar"></div>
    <div class="hero-left-rule"></div>

    <div class="hero-content">
      <div class="hero-eyebrow">Stuntman · Artist · Dresden, Germany</div>
      <h1 class="hero-name">
        ILIAN<br />
        <span class="hero-name-accent">SIMEONOW</span>
      </h1>
      <p class="hero-role">Stunt Performer · Action Artist · Actor · Magician</p>
      <div class="hero-actions">
        <a href="/en/video/" class="btn-primary">Watch Showreel</a>
        <a href="/en/credits/" class="btn-ghost">Credits &amp; References</a>
      </div>
      <div class="hero-stats">
        <div><div class="stat-num">23+</div><div class="stat-label">Years Experience</div></div>
        <div><div class="stat-num">46+</div><div class="stat-label">Productions</div></div>
        <div><div class="stat-num">12+</div><div class="stat-label">Stunt Disciplines</div></div>
        <div><div class="stat-num">6</div><div class="stat-label">Countries</div></div>
      </div>
    </div>
    <div class="hero-side-text">Stuntman · Stunt Performer · Action Artist · Actor</div>
  </section>

  <div class="skills-strip">
    <div class="skill-tag skill-tag--highlight">Body Stunt</div>
    <div class="skill-tag">High Fall</div>
    <div class="skill-tag skill-tag--highlight">Fencing &amp; Sword Fighting</div>
    <div class="skill-tag">Stunt Riding</div>
    <div class="skill-tag skill-tag--highlight">Trampoline Stunt Performer</div>
    <div class="skill-tag">Globe of Speed</div>
    <div class="skill-tag skill-tag--highlight">Fight Choreography</div>
    <div class="skill-tag">Wheel of Death</div>
    <div class="skill-tag skill-tag--highlight">Magic &amp; Illusion</div>
    <div class="skill-tag">Fire Breathing</div>
    <div class="skill-tag skill-tag--highlight">Acrobatics</div>
    <div class="skill-tag">Acting &amp; Comedy</div>
  </div>

  <section class="about-section">
    <div>
      <div class="section-label">// About</div>
      <h2 class="section-heading">Stunt Performer<br />by Passion.</h2>
      <p class="body-text">
        Looking for a fight choreographer, stunt coordinator, action performer, stuntman, comedian, magician or artist? You've come to the right place.
      </p>
      <p class="body-text" style="margin-top: 18px;">
        For over 23 years, Ilian Simeonow has performed on international stages — from Norway to Dubai.
      </p>
      <a href="/en/biography/" class="link-more">Read biography →</a>
    </div>
    <div class="photo-block">
      <span class="photo-placeholder-label">Portrait / Action Photo</span>
      <div class="photo-caption">Stuntman · Dresden</div>
    </div>
  </section>

  <section class="productions-section">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <div class="section-label">// Recent Productions</div>
        <h2 class="section-heading">Latest &amp;<br />News.</h2>
      </div>
      <a href="/en/credits/" class="link-more" style="margin-top: 0;">View all credits →</a>
    </div>
    <div class="productions-list">
      <div class="production-item">
        <div class="production-year">2024</div>
        <div class="production-text">Karl-May Festival Radebeul &amp; Felsenbühne Rathen. Also again with AWEGO at Jakubzburg in Mortka.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2023</div>
        <div class="production-text">Karl-May Festival with Stunt Team Awego &amp; Jakubzburg in Mortka — "Die Töchter der Burg" (Role: Fou).</div>
      </div>
      <div class="production-item">
        <div class="production-year">2022</div>
        <div class="production-text">Semperoper Dresden — <em style="color: var(--white);">Der Wildschütz</em> (from September).</div>
      </div>
      <div class="production-item">
        <div class="production-year">2019</div>
        <div class="production-text">Final season Eldorado Templin. Semperoper Dresden — <em style="color: var(--white);">Die Verkaufte Braut / Der Freischütz / Der Wildschütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2017</div>
        <div class="production-text">Semperoper Dresden — <em style="color: var(--white);">Der Freischütz</em>. Joined ELDORADO Stunt Team Templin.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2013</div>
        <div class="production-text">Feature film <em style="color: var(--white);">La belle &amp; la bête</em> — Stunt double Nicolas Gob. Motorrad Messe Leipzig with Globe of Speed.</div>
      </div>
    </div>
  </section>

  <section class="credits-section">
    <div class="credits-section-header">
      <div>
        <div class="section-label">// Credits &amp; References</div>
        <h2 class="section-heading">Selected<br />Productions.</h2>
      </div>
      <a href="/en/credits/" class="link-more" style="margin-top: 0;">All 46+ Credits →</a>
    </div>
    <div class="credits-tabs">
      <div class="credits-tab credits-tab--active">Stunt Performer</div>
      <div class="credits-tab">Actor</div>
      <div class="credits-tab">Artist</div>
      <div class="credits-tab">Further Clients</div>
    </div>
    <div class="credits-grid">
      <div class="credit-card"><div class="credit-year">2024</div><div class="credit-title">Karl-May-Festspiele Radebeul</div><div class="credit-role">Stunts · Riding · Fighting · Acting</div></div>
      <div class="credit-card"><div class="credit-year">2024</div><div class="credit-title">Felsenbühne Rathen — Winnetou</div><div class="credit-role">Stunts · Riding · Fighting</div></div>
      <div class="credit-card"><div class="credit-year">2017–2019</div><div class="credit-title">Eldorado Templin</div><div class="credit-role">Stunts · Riding · Fighting · Acting</div></div>
      <div class="credit-card"><div class="credit-year">2015–2017</div><div class="credit-title">Semperoper Dresden — Freischütz</div><div class="credit-role">Stunts · Fighting</div></div>
      <div class="credit-card"><div class="credit-year">2013</div><div class="credit-title">La belle &amp; la bête</div><div class="credit-role">Stunt Double — Nicolas Gob</div></div>
      <div class="credit-card"><div class="credit-year">2011</div><div class="credit-title">The Three Musketeers</div><div class="credit-role">Stunts · Fencing · Cardinal Guard</div></div>
      <div class="credit-card"><div class="credit-year">2009–2011</div><div class="credit-title">Piraten Open Air Theatre</div><div class="credit-role">Stunts · Fencing · Acting</div></div>
      <div class="credit-card"><div class="credit-year">2004</div><div class="credit-title">Silver Lake City</div><div class="credit-role">Stunts · Riding · Fighting</div></div>
      <div class="credit-card credit-card--more"><div style="text-align: center;"><div class="section-label" style="margin-bottom: 8px;">+38 more</div><a href="/en/credits/" style="font-family: var(--font-sans); font-size: 13px; color: var(--gray);">Full credits →</a></div></div>
    </div>
  </section>

  <section class="skills-section">
    <div class="skills-section-header">
      <div>
        <div class="section-label">// Skills</div>
        <h2 class="section-heading">Stunts, Acrobatics<br />&amp; More.</h2>
        <p class="body-text" style="max-width: 480px;">
          After a 5½-year training at the State Ballet School Berlin, Ilian specialised as a trampoline stunt performer — the origin of the modern stuntman.
        </p>
        <a href="/en/skills/" class="link-more">View all skills →</a>
      </div>
    </div>
    <div class="skills-categories">
      <div class="skills-cat">
        <div class="skills-cat-title">Acrobatics / X-treme Artistry</div>
        <ul class="skills-cat-list">
          <li>Trampoline</li><li>Teeterboard</li><li>Floor Acrobatics</li>
          <li>Juggling</li><li>Magic &amp; Illusion</li><li>Globe of Speed</li>
          <li>Wheel of Death</li><li>Fire Breathing / Eating</li>
        </ul>
      </div>
      <div class="skills-cat">
        <div class="skills-cat-title">Stunt</div>
        <ul class="skills-cat-list">
          <li>Body Stunt</li><li>High Fall</li><li>Fencing &amp; Sword Fighting</li>
          <li>Horse Riding (Stunt Riding)</li><li>Fight Choreography</li>
          <li>Martial Arts (Tae Kwon Do · Capoeira · Judo · Boxing)</li>
          <li>Firearms Training</li><li>Abseiling</li>
        </ul>
      </div>
      <div class="skills-cat">
        <div class="skills-cat-title">Own Equipment</div>
        <ul class="skills-cat-list">
          <li>Mats (various sizes)</li><li>Abseiling Equipment</li>
          <li>Foils &amp; Swords</li><li>Police Uniform NRW</li>
          <li>Medieval Costume</li><li>Western Costume</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="gallery-section">
    <div class="gallery-section-header">
      <div>
        <div class="section-label">// Gallery</div>
        <h2 class="section-heading">Photos from<br />Production &amp; Show.</h2>
      </div>
      <a href="/en/gallery/" class="link-more" style="margin-top: 0;">View all photos →</a>
    </div>
    <div class="gallery-grid">
      <div class="gallery-thumb"><div class="gallery-thumb-icon">Action · Stunt</div><div class="gallery-label">Stunt</div></div>
      <div class="gallery-thumb"><div class="gallery-thumb-icon">Portrait</div><div class="gallery-label">Portrait</div></div>
      <div class="gallery-thumb"><div class="gallery-thumb-icon">Stage</div><div class="gallery-label">Comedian &amp; Actor</div></div>
      <div class="gallery-thumb"><div class="gallery-thumb-icon">Acrobatics</div><div class="gallery-label">Acrobatics</div></div>
      <div class="gallery-thumb"><div class="gallery-thumb-icon">Various Productions</div><div class="gallery-label">Productions</div></div>
    </div>
  </section>

  <section class="video-section">
    <div>
      <div class="section-label">// Showreel &amp; Videos</div>
      <h2 class="section-heading">Seeing is<br />Believing.</h2>
      <p class="body-text">Demo reel, stunt reel and further videos show Ilian Simeonow in action — from film, television, stage and live shows.</p>
      <a href="/en/video/" class="link-more">View all videos →</a>
    </div>
    <div class="video-thumb">
      <div class="play-btn"><div class="play-icon"></div></div>
    </div>
  </section>

  <section class="partners-section">
    <div class="section-label">// Partners &amp; Colleagues</div>
    <h2 class="section-heading">Working with<br />Professionals.</h2>
    <div class="partners-grid">
      <div class="partner-card"><div class="partner-name">Ralf Tilmann</div><div class="partner-role">Director · Stunt Coordinator · Stuntman</div></div>
      <div class="partner-card"><div class="partner-name">Andreas Mintert</div><div class="partner-role">Actor · Stuntman · Host</div></div>
      <div class="partner-card"><div class="partner-name">Globe of Speed</div><div class="partner-role">Globe of Speed &amp; Wheel of Death</div></div>
      <div class="partner-card"><div class="partner-name">Andreas Feller</div><div class="partner-role">Director · Actor · Feller Film Production</div></div>
      <div class="partner-card"><div class="partner-name">Mario Eichendorf</div><div class="partner-role">Actor · Stunt Coordinator · Stuntman</div></div>
      <div class="partner-card"><div class="partner-name">Sven Thorsten Gliwe</div><div class="partner-role">Stunt Coordinator · Stuntman · Pyrotechnician</div></div>
      <div class="partner-card"><div class="partner-name">Hendrik Leschke</div><div class="partner-role">Stuntman · Dancer · Free Running</div></div>
      <div class="partner-card"><div class="partner-name">Ole Gäbel</div><div class="partner-role">Catering · Event Team</div></div>
    </div>
  </section>

  <section class="wissen-section">
    <div class="section-label">// Knowledge</div>
    <h2 class="section-heading">Learn More.</h2>
    <div class="wissen-grid">
      <div class="wissen-card">
        <div class="wissen-num">01</div>
        <div class="wissen-title">History of the Stuntman</div>
        <div class="wissen-desc">From circus to cinema — how the stuntman emerged, from Buster Keaton to Jackie Chan.</div>
        <a href="/en/knowledge/history-stuntman/" class="wissen-link">Read article →</a>
      </div>
      <div class="wissen-card">
        <div class="wissen-num">02</div>
        <div class="wissen-title">How to Become a Stuntman?</div>
        <div class="wissen-desc">Requirements, training paths and Ilian's personal recommendations for newcomers.</div>
        <a href="/en/knowledge/how-to-stuntman/" class="wissen-link">Read article →</a>
      </div>
      <div class="wissen-card">
        <div class="wissen-num">03</div>
        <div class="wissen-title">History of Circus Arts</div>
        <div class="wissen-desc">Acrobatics, equilibristics, juggling — the art forms that shaped Ilian's training.</div>
        <a href="/en/knowledge/history-circus-arts/" class="wissen-link">Read article →</a>
      </div>
      <div class="wissen-card">
        <div class="wissen-num">04</div>
        <div class="wissen-title">How to Become an Artist?</div>
        <div class="wissen-desc">State and private circus schools, youth circus and alternative training paths.</div>
        <a href="/en/knowledge/how-to-artist/" class="wissen-link">Read article →</a>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div>
      <div class="section-label">// Booking &amp; Contact</div>
      <div class="contact-heading">Book<br />Ilian.</div>
      <p class="contact-sub">Stunt Coordinator · Fight Choreographer<br />Action Performer · Artist · Magician</p>
      <div class="contact-actions">
        <a href="/en/contact/" class="btn-primary">Send Enquiry</a>
        <a href="/pdfs/setcard-en.pdf" download class="btn-ghost">↓ Sedcard PDF</a>
      </div>
    </div>
    <div class="contact-info">
      <div class="contact-detail"><strong>Phone</strong>+49 (0)176 / 303 101 42</div>
      <div class="contact-detail"><strong>E-Mail</strong>actionartist@web.de</div>
      <div class="contact-detail"><strong>Address</strong>Hülseweg 5 · 42579 Heiligenhaus · Germany</div>
    </div>
  </section>

</Layout>

<script>
  const vid = document.getElementById('heroBgVideo') as HTMLVideoElement | null;
  if (vid) {
    vid.addEventListener('canplaythrough', () => vid.classList.add('hero-video--loaded'));
    vid.addEventListener('error', () => vid.remove());
  }
</script>
