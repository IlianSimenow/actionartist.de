---
import Layout from '../../layouts/Layout.astro';
import ContactInfo from '../../components/ContactInfo.astro';
import SkillsStrip from '../../components/SkillsStrip.astro';
---

<Layout lang="en" title="Ilian Simeonow — Stuntman & Artist from Dresden" description="Ilian Simeonow — stuntman, stunt performer, artist and actor from Dresden. 23+ years in film, TV and theatre. Available for bookings.">

  <section class="hero">
    <video class="hero-video" id="heroBgVideo" autoplay muted loop playsinline preload="auto">
      <source src="/assets/video/hero-loop.webm" type="video/webm" />
      <source src="/assets/video/hero-loop.mp4"  type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-grain"></div>
    <div class="hero-top-bar"></div>
    <div class="hero-left-rule"></div>

    <div class="hero-content">
      <div class="hero-eyebrow">Stuntman · Artist · Dresden, Germany</div>
      <h1 class="hero-name">
        ILIAN<br />
        <span class="hero-name-accent">SIMEONOW</span>
      </h1>
      <p class="hero-role">Stunt Performer · Action Artist · Actor · Magician</p>
      <div class="hero-actions">
        <a href="/en/video/" class="btn-primary">Watch Showreel</a>
        <a href="/en/credits/" class="btn-ghost">Credits &amp; References</a>
      </div>
    </div>

    <div class="hero-side-text">Stuntman · Stunt Performer · Action Artist · Actor</div>
  </section>

  <!-- skills carousel — home only, between about and news -->

  <section class="about-section">
    <div>
      <div class="section-label">// About</div>
      <h2 class="section-heading">Stunt Performer<br />by Passion.</h2>
      <p class="body-text">
        Looking for a fight choreographer, stunt coordinator, action performer, stuntman, comedian, magician or artist? You've come to the right place.
      </p>
      <p class="body-text" style="margin-top: 18px;">
        For over 23 years, Ilian Simeonow has performed on international stages — from Norway to Dubai.
      </p>
      <a href="/en/biography/" class="link-more">Read biography →</a>
    </div>
    <div class="photo-block" style="max-width: 50%; margin: 0 auto;">
      <img src="/images/portrait/Portr%C3%A4tfoto-3.jpg" alt="Ilian Simeonow — Stuntman & Artist" loading="lazy" />
      <div class="photo-caption">Stuntman · Dresden</div>
    </div>
  </section>

  <SkillsStrip lang="en" />

  <section class="productions-section">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <div class="section-label">// Recent Productions</div>
        <h2 class="section-heading">Latest &amp;<br />News.</h2>
      </div>
      <a href="/en/credits/" class="link-more" style="margin-top: 0;">View all credits →</a>
    </div>
    <div class="productions-list">
      <div class="production-item">
        <div class="production-year">2024</div>
        <div class="production-text">Karl-May Festival Radebeul &amp; Felsenbühne Rathen. Also again with AWEGO at Jakubzburg in Mortka.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2023</div>
        <div class="production-text">Karl-May Festival with Stunt Team Awego &amp; Jakubzburg in Mortka — "Die Töchter der Burg" (Role: Fou).</div>
      </div>
      <div class="production-item">
        <div class="production-year">2022</div>
        <div class="production-text">Semperoper Dresden — <em style="color: var(--white);">Der Wildschütz</em> (from September).</div>
      </div>
      <div class="production-item">
        <div class="production-year">2020</div>
        <div class="production-text">Host of the Monster Show at the Motorrad Messe Dortmund. Globe of Speed appearances. From March 2020 to September 2022: COVID-related break.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2019</div>
        <div class="production-text">Final season Eldorado Templin. Semperoper Dresden — <em style="color: var(--white);">Die Verkaufte Braut / Der Freischütz / Der Wildschütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2018</div>
        <div class="production-text">Professional cowboy in Templin. Semperoper Dresden — <em style="color: var(--white);">Der Freischütz / Der Wildschütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2017</div>
        <div class="production-text">Semperoper Dresden — <em style="color: var(--white);">Der Freischütz</em>. Joined ELDORADO Stunt Team Templin.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2016</div>
        <div class="production-text">Stunt coordinator &amp; fight choreographer — <em style="color: var(--white);">Das Vermächtnis (Müritz Saga)</em>, Waren a. d. Müritz. Semperoper Dresden — <em style="color: var(--white);">Der Wildschütz / Der Freischütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2015</div>
        <div class="production-text"><em style="color: var(--white);">Müritz Saga</em>, Waren a. d. Müritz — Role: Loddar. Semperoper Dresden — <em style="color: var(--white);">Der Freischütz</em>.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2014</div>
        <div class="production-text">Open-air theatre <em style="color: var(--white);">1000 Jahre Brandenburg — Theatro Spectacula</em> — Role: Dietrich.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2013</div>
        <div class="production-text">Feature film <em style="color: var(--white);">La belle &amp; la bête</em> — Stunt double Nicolas Gob. Motorrad Messe Leipzig with Globe of Speed.</div>
      </div>
      <div class="production-item">
        <div class="production-year">2011</div>
        <div class="production-text">Final appearance at Piraten Open Air Theater Grevesmühlen — Role: Don Merdas. Globe of Speed incl. Tuning World Bodensee. Feature film <em style="color: var(--white);">The Three Musketeers</em>.</div>
