---
import Layout from '../../../layouts/Layout.astro';
import ContactInfo from '../../../components/ContactInfo.astro';
---

<Layout lang="en" title="Showreel & Videos — Ilian Simeonow"  description="Demo reel, stunt reel and further videos of Ilian Simeonow — stuntman, artist and actor from Dresden." heroImage="/images/stunt/Diving-1.jpg">

  <div class="page-hero page-hero--standard">
    <div class="hero-top-bar"></div>
    <div class="page-hero-content">
      <div class="section-label">// Showreel &amp; Videos</div>
      <h1 class="page-hero-title">Seeing is<br /><span style="color: var(--orange);">Believing.</span></h1>
      <p class="page-hero-sub">Demo Reel · Stunt Reel · Further Videos</p>
    </div>
  </div>

  <section class="video-main-section">
    <div class="section-label">// Showreel</div>
    <h2 class="section-heading">Action-Acting,<br />Comedy &amp; Stunts.</h2>
    <p class="body-text" style="max-width: 600px; margin-bottom: 40px;">
      A selection of Ilian's work as a stuntman, actor and artist — from film stunts to comedy to fight choreography.
    </p>
    <div class="video-embed-block">
      <iframe
        src="https://www.youtube-nocookie.com/embed/JPweVnDgEUI"
        title="Ilian Simeonow - Action-Acting, Comedy & Stunts"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </section>

  <section class="video-list-section">
    <div class="section-label">// All Videos</div>
    <h2 class="section-heading">Watch More.</h2>
    <div class="video-grid">

      <a class="video-card" href="https://www.youtube.com/watch?v=Ljat6OkeFsw" target="_blank" rel="noopener">
        <div class="video-thumb-sm">
          <img src="https://img.youtube.com/vi/Ljat6OkeFsw/mqdefault.jpg" alt="Ilian Simeonow - Demoreel 2010" loading="lazy" />
          <div class="play-btn-sm"><div class="play-icon-sm"></div></div>
          <div class="video-duration">1:38</div>
        </div>
        <div class="video-card-info">
          <div class="video-card-year">2010</div>
          <div class="video-card-title">Demoreel 2010</div>
          <div class="video-card-desc">Stunt and acting demo from film productions</div>
        </div>
      </a>

      <a class="video-card" href="https://www.youtube.com/watch?v=v__dgOh2zpQ" target="_blank" rel="noopener">
        <div class="video-thumb-sm">
          <img src="https://img.youtube.com/vi/v__dgOh2zpQ/mqdefault.jpg" alt="Ilian Simeonow - Stunt Reel 2011" loading="lazy" />
          <div class="play-btn-sm"><div class="play-icon-sm"></div></div>
          <div class="video-duration">1:30</div>
        </div>
        <div class="video-card-info">
          <div class="video-card-year">2011</div>
          <div class="video-card-title">Stunt Reel 2011</div>
          <div class="video-card-desc">Stunt sequences from film and theatre productions</div>
        </div>
      </a>

      <a class="video-card" href="https://www.youtube.com/watch?v=lQbVXPMbBII" target="_blank" rel="noopener">
        <div class="video-thumb-sm">
          <img src="https://img.youtube.com/vi/lQbVXPMbBII/mqdefault.jpg" alt="Stuntteam Action-Artist" loading="lazy" />
          <div class="play-btn-sm"><div class="play-icon-sm"></div></div>
          <div class="video-duration">2:41</div>
        </div>
        <div class="video-card-info">
          <div class="video-card-year">Stunt Team</div>
          <div class="video-card-title">Stuntteam Action-Artist</div>
          <div class="video-card-desc">The Action-Artist stunt team in action</div>
        </div>
      </a>

      <a class="video-card" href="https://www.youtube.com/watch?v=PGXdgc0M1yw" target="_blank" rel="noopener">
        <div class="video-thumb-sm">
          <img src="https://img.youtube.com/vi/PGXdgc0M1yw/mqdefault.jpg" alt="Training - Ilian Simeonow 2006" loading="lazy" />
          <div class="play-btn-sm"><div class="play-icon-sm"></div></div>
          <div class="video-duration">3:57</div>
        </div>
        <div class="video-card-info">
          <div class="video-card-year">2006</div>
          <div class="video-card-title">Training 2006</div>
          <div class="video-card-desc">Training and preparation — stunt & acrobatics</div>
        </div>
      </a>

      <a class="video-card" href="https://www.youtube.com/watch?v=-ShWB1quPhY" target="_blank" rel="noopener">
        <div class="video-thumb-sm">
          <img src="https://img.youtube.com/vi/-ShWB1quPhY/mqdefault.jpg" alt="Ilian Simeonow / knife throwing" loading="lazy" />
          <div class="play-btn-sm"><div class="play-icon-sm"></div></div>
          <div class="video-duration">0:54</div>
        </div>
        <div class="video-card-info">
          <div class="video-card-year">Knife Throwing</div>
          <div class="video-card-title">Knife Throwing</div>
          <div class="video-card-desc">Professional knife throwing as a stage act</div>
        </div>
      </a>

      <a class="video-card video-card--yt" href="https://www.youtube.com/@mractionartist" target="_blank" rel="noopener">
        <div class="video-thumb-sm video-thumb-yt">
          <svg width="48" height="34" viewBox="0 0 48 34" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="34" rx="8" fill="#FF0000"/><path d="M19 10l14 7-14 7V10z" fill="white"/></svg>
        </div>
        <div class="video-card-info">
          <div class="video-card-year">YouTube</div>
          <div class="video-card-title">Watch All Videos</div>
          <div class="video-card-desc">@mractionartist on YouTube</div>
        </div>
      </a>

    </div>
  </section>

  <section class="contact-section">
    <div>
      <div class="section-label">// Booking</div>
      <div class="contact-heading">Book<br />Ilian.</div>
      <div class="contact-actions">
        <a href="/en/contact/" class="btn-primary">Send Enquiry</a>
        <a href="/en/credits/" class="btn-ghost">View Credits</a>
      </div>
    </div>
    <ContactInfo lang="en" />
  </section>

</Layout>

<style>
.video-main-section { padding: var(--section-pad) var(--page-pad); background: var(--black); border-top: 1px solid var(--border); }
.video-embed-block { aspect-ratio: 16/9; max-width: 900px; background: #000; }
.video-embed-block iframe { width: 100%; height: 100%; border: none; display: block; }
.video-list-section { padding: var(--section-pad) var(--page-pad); background: var(--dark); border-top: 1px solid var(--border); }
.video-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); margin-top: 40px; }
.video-card { background: var(--dark); display: flex; flex-direction: column; text-decoration: none; transition: opacity 0.2s; }
.video-card:hover { opacity: 0.85; }
.video-thumb-sm { aspect-ratio: 16/9; background: var(--card); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.video-thumb-sm img { width: 100%; height: 100%; object-fit: cover; display: block; }
.video-thumb-yt { background: #111; }
.play-btn-sm { position: absolute; width: 48px; height: 48px; border-radius: 50%; background: rgba(200,80,20,0.9); display: flex; align-items: center; justify-content: center; }
.play-icon-sm { width: 0; height: 0; border-top: 9px solid transparent; border-bottom: 9px solid transparent; border-left: 14px solid #fff; margin-left: 3px; }
.video-duration { position: absolute; bottom: 8px; right: 8px; font-family: var(--font-sans); font-size: 11px; font-weight: 700; color: #fff; background: rgba(0,0,0,0.8); padding: 2px 6px; }
.video-card-info { padding: 20px; }
.video-card-year { font-family: var(--font-sans); font-size: 11px; letter-spacing: 2px; color: var(--orange); font-weight: 600; margin-bottom: 8px; text-transform: uppercase; }
.video-card-title { font-family: var(--font-serif); font-size: 16px; color: var(--white); margin-bottom: 8px; font-style: italic; }
.video-card-desc { font-family: var(--font-sans); font-size: 13px; color: var(--gray); line-height: 1.5; }
</style>
