<style>
.credits-full-section { background: var(--black); border-top: 1px solid var(--border); }
.credits-category { padding: var(--section-pad) var(--page-pad) 0; border-bottom: 1px solid var(--border); padding-bottom: var(--section-pad); }
.credits-cat-header { margin-bottom: 32px; }
.credits-full-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); }
.weitere-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); }
.weitere-item { background: var(--card); padding: 20px 24px; font-family: var(--font-sans); font-size: 14px; color: var(--gray); }
.weitere-note { font-family: var(--font-sans); font-size: 13px; color: var(--gray); margin-top: 24px; line-height: 1.6; }
</style>
