---
import Layout from '../../../layouts/Layout.astro';
import ContactDetails from '../../../components/ContactDetails.astro';
---

<Layout lang="en" title="Contact — Ilian Simeonow"  description="Contact Ilian Simeonow — booking enquiries for stunt, acrobatics and acting. Phone, email and sedcard download." heroImage="/images/portrait/Portr%C3%A4tfoto-3.jpg">

  <div class="page-hero page-hero--contact">
    <div class="hero-top-bar"></div>
    <div class="page-hero-content">
      <div class="section-label">// Booking &amp; Contact</div>
      <h1 class="page-hero-title">Get in<br /><span style="color: var(--orange);">Touch.</span></h1>
      <p class="page-hero-sub">Booking Enquiries · Production Enquiries · Sedcard</p>
    </div>
  </div>

  <section class="contact-main-section">
    <div class="contact-grid">
      <div class="contact-form-col">
        <div class="section-label">// Enquiry</div>
        <h2 class="section-heading">Send an<br />Enquiry.</h2>
        <p class="body-text" style="margin-bottom: 40px;">
          For booking enquiries, information or questions about productions, please fill in the form below. Ilian typically responds within 24 hours.
        </p>

        <form class="contact-form" id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="name">Name *</label>
              <input type="text" id="name" class="form-input" placeholder="Your name" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="email">E-Mail *</label>
              <input type="email" id="email" class="form-input" placeholder="your@email.com" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Phone</label>
            <input type="tel" id="phone" class="form-input" placeholder="+49 ..." />
          </div>
          <div class="form-group">
            <label class="form-label" for="type">Type of Enquiry</label>
            <select id="type" class="form-input">
              <option value="">Please select …</option>
              <option>Film / TV</option>
              <option>Theatre / Opera</option>
              <option>Open Air / Festival</option>
              <option>Trade Show / Event</option>
              <option>Show / Variety</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="message">Message *</label>
            <textarea id="message" class="form-input form-textarea" placeholder="Please describe your project, the desired timeframe and any special requirements …" required></textarea>
          </div>
          <div id="form-status" class="form-status" aria-live="polite"></div>
          <button type="submit" id="form-submit" class="btn-primary" style="width: 100%; text-align: center;">Send Enquiry</button>
        </form>

        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement;
          const status = document.getElementById('form-status')!;
          const submit = document.getElementById('form-submit') as HTMLButtonElement;

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            submit.disabled = true;
            submit.textContent = 'Sending …';
            status.className = 'form-status';
            status.textContent = '';

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: (document.getElementById('name') as HTMLInputElement).value,
                  email: (document.getElementById('email') as HTMLInputElement).value,
                  phone: (document.getElementById('phone') as HTMLInputElement).value,
                  type: (document.getElementById('type') as HTMLSelectElement).value,
                  message: (document.getElementById('message') as HTMLTextAreaElement).value,
                  lang: 'en',
                }),
              });

              if (res.ok) {
                status.className = 'form-status form-status--success';
                status.textContent = 'Thank you! Your enquiry has been sent. Ilian will be in touch shortly.';
                form.reset();
                submit.textContent = 'Enquiry sent ✓';
              } else {
                status.className = 'form-status form-status--error';
                status.textContent = 'Something went wrong. Please try again or contact us directly by email.';
                submit.disabled = false;
                submit.textContent = 'Send Enquiry';
              }
            } catch {
              status.className = 'form-status form-status--error';
              status.textContent = 'Connection error. Please check your internet connection or email us directly.';
              submit.disabled = false;
              submit.textContent = 'Send Enquiry';
            }
          });
        </script>
      </div>

      <div>
      <ContactDetails lang="en" />

        <div class="sedcard-download-block">
          <div class="section-label" style="margin-bottom: 16px;">// Sedcard &amp; CV</div>
          <p class="body-text" style="font-size: 14px; margin-bottom: 20px;">
            Download Ilian's sedcard and CV as PDF — with photos, physical data, skills and full production history.
          </p>
          {/* prompt: split combined "↓ Sedcard & CV PDF" into two separate download buttons */}
          <div class="sedcard-download-actions">
            {/* Sedcard PDF (English variant) */}
            <a href="/pdfs/setcard-en.pdf" download class="btn-outline-orange sedcard-download-btn">↓ Sedcard PDF</a>
            {/* CV / Vita PDF (single file shared across languages) */}
            <a href="/pdfs/Ilian-Vita.pdf" download class="btn-outline-orange sedcard-download-btn">↓ CV PDF</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
.contact-main-section { padding: var(--section-pad) var(--page-pad); background: var(--black); border-top: 1px solid var(--border); }
.contact-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 80px; align-items: start; }
.contact-form { display: flex; flex-direction: column; gap: 20px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-group { display: flex; flex-direction: column; gap: 8px; }
.form-label { font-family: var(--font-sans); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); font-weight: 600; }
.form-input { background: var(--card); border: 1px solid var(--border); color: var(--white); font-family: var(--font-sans); font-size: 15px; padding: 14px 16px; width: 100%; outline: none; transition: border-color 0.2s; }
.form-input:focus { border-color: var(--orange); }
.form-input option { background: var(--card); }
.form-textarea { min-height: 140px; resize: vertical; }
.contact-info-col { display: flex; flex-direction: column; }
.contact-detail-block { display: flex; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--border); align-items: center; }
.contact-detail-icon { color: var(--orange); flex-shrink: 0; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; }
.contact-detail-label { font-family: var(--font-sans); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--orange); margin-bottom: 6px; }
.contact-detail-value { font-family: var(--font-sans); font-size: 16px; color: var(--white); line-height: 1.5; }
a.contact-detail-value:hover { color: var(--orange); }
.sedcard-download-block { margin-top: 40px; padding: 28px; background: var(--card); border: 1px solid var(--border); }
/* two-column layout for separate Sedcard / CV download buttons; collapses to stacked on narrow screens */
.sedcard-download-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.sedcard-download-btn { display: block; text-align: center; padding: 14px 24px; }
@media (max-width: 480px) { .sedcard-download-actions { grid-template-columns: 1fr; } }
.form-status { display: none; padding: 14px 16px; font-family: var(--font-sans); font-size: 14px; line-height: 1.5; }
.form-status--success { display: block; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); color: #4ade80; }
.form-status--error { display: block; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; }
</style>
