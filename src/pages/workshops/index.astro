---
import Layout from '../../layouts/Layout.astro';
import ContactInfo from '../../components/ContactInfo.astro';
---

<Layout lang="de" title="Workshops — Ilian Simeonow" description="Workshops für Bühnenfechten, Stunt und Kinderzirkus mit Ilian Simeonow. Buchbar für Schulen, Theater und Einzelpersonen." heroImage="/images/stunt/Fechten-2.jpg">

  <div class="page-hero page-hero--workshops">
    <div class="hero-top-bar"></div>
    <div class="page-hero-content">
      <div class="section-label">// Workshops</div>
      <h1 class="page-hero-title">Workshops<br /><span style="color: var(--orange);">buchen.</span></h1>
      <p class="page-hero-sub">Fechten · Stunt · Kinderzirkus</p>
    </div>
  </div>

  <section class="workshops-section">
    <div class="section-label">// Angebot</div>
    <h2 class="section-heading">Alle<br />Workshops.</h2>
    <p class="body-text" style="max-width: 600px; margin-bottom: 56px;">
      Ilian Simeonow bietet professionelle Workshops für Einzelpersonen, Gruppen, Schulen und Theater an — von Bühnenfechten über Stunt bis zum Kinderzirkus.
    </p>

    <div class="workshops-grid">
      <a class="workshop-card" href="/workshops/fechten/">
        <div class="workshop-num">01</div>
        <div class="workshop-name">Workshop Fechten</div>
        <div class="workshop-desc">Bühnenfechten · Kampfchoreographie · Bühnenkampf — für Schauspieler, Sportfechter und Einsteiger.</div>
        <div class="workshop-link">Workshop ansehen →</div>
      </a>
      <a class="workshop-card" href="/workshops/stunt/">
        <div class="workshop-num">02</div>
        <div class="workshop-name">Workshop Stunt</div>
        <div class="workshop-desc">Grundlagen des Stunt-Handwerks: Fallen, Kämpfen, Choreographie — sicher und professionell.</div>
        <div class="workshop-link">Workshop ansehen →</div>
      </a>
      <a class="workshop-card" href="/workshops/kinderzirkus/">
        <div class="workshop-num">03</div>
        <div class="workshop-name">Workshop Kinderzirkus</div>
        <div class="workshop-desc">Trampolin, Jonglage, Akrobatik und mehr — für Kinder und Jugendliche.</div>
        <div class="workshop-link">Workshop ansehen →</div>
      </a>
    </div>
  </section>

  <section class="contact-section">
    <div>
      <div class="section-label">// Buchung</div>
      <div class="contact-heading">Anfrage<br />senden.</div>
      <div class="contact-actions">
        <a href="/kontakt/" class="btn-primary">Workshop anfragen</a>
      </div>
    </div>
    <ContactInfo lang="de" />
  </section>

</Layout>

<style>
.workshops-section {
  padding: var(--section-pad) var(--page-pad);
  background: var(--black);
  border-top: 1px solid var(--border);
}
.workshops-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
}
.workshop-card {
  background: var(--card);
  padding: 40px 32px;
  display: block;
  text-decoration: none;
  color: inherit;
  transition: background 0.2s;
}
.workshop-card:hover { background: #1f1f1f; }
.workshop-num {
  font-family: var(--font-serif);
  font-size: 28px;
  color: var(--border);
  font-weight: bold;
  margin-bottom: 16px;
}
.workshop-name {
  font-family: var(--font-serif);
  font-size: 24px;
  color: var(--white);
  font-weight: bold;
  margin-bottom: 12px;
}
.workshop-desc {
  font-family: var(--font-sans);
  font-size: 14px;
  color: var(--gray);
  line-height: 1.6;
  margin-bottom: 20px;
}
.workshop-link {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--orange);
}
@media (max-width: 768px) {
  .workshops-grid { grid-template-columns: 1fr; }
}
</style>
