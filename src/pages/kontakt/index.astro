---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="de" title="Kontakt — Ilian Simeonow"  description="Ilian Simeonow kontaktieren — Buchungsanfragen für Stunt, Artistik und Schauspiel. Telefon, E-Mail und Sedcard-Download." heroImage="/images/portrait/Portr%C3%A4tfoto-3.jpg">

  <div class="page-hero">
    <div class="hero-top-bar"></div>
    <div class="page-hero-content">
      <div class="section-label">// Buchung &amp; Kontakt</div>
      <h1 class="page-hero-title">Kontakt<br /><span style="color: var(--orange);">aufnehmen.</span></h1>
      <p class="page-hero-sub">Buchungsanfragen · Produktionsanfragen · Sedcard</p>
    </div>
  </div>

  <section class="contact-main-section">
    <div class="contact-grid">
      <div class="contact-form-col">
        <div class="section-label">// Anfrage</div>
        <h2 class="section-heading">Anfrage<br />senden.</h2>
        <p class="body-text" style="margin-bottom: 40px;">
          Für Buchungsanfragen, Informationen oder Fragen zu Produktionen füllen Sie bitte das Formular aus. Ilian antwortet in der Regel innerhalb von 24 Stunden.
        </p>

        <form class="contact-form" id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="name">Name *</label>
              <input type="text" id="name" class="form-input" placeholder="Ihr Name" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="email">E-Mail *</label>
              <input type="email" id="email" class="form-input" placeholder="ihre@email.de" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Telefon</label>
            <input type="tel" id="phone" class="form-input" placeholder="+49 ..." />
          </div>
          <div class="form-group">
            <label class="form-label" for="type">Art der Anfrage</label>
            <select id="type" class="form-input">
              <option value="">Bitte wählen …</option>
              <option>Film / TV</option>
              <option>Theater / Oper</option>
              <option>Open-Air / Festival</option>
              <option>Messe / Event</option>
              <option>Show / Varieté</option>
              <option>Sonstiges</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="message">Nachricht *</label>
            <textarea id="message" class="form-input form-textarea" placeholder="Beschreiben Sie Ihr Projekt, den gewünschten Zeitraum und besondere Anforderungen …" required></textarea>
          </div>
          <div id="form-status" class="form-status" aria-live="polite"></div>
          <button type="submit" id="form-submit" class="btn-primary" style="width: 100%; text-align: center;">Anfrage senden</button>
        </form>

        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement;
          const status = document.getElementById('form-status')!;
          const submit = document.getElementById('form-submit') as HTMLButtonElement;

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            submit.disabled = true;
            submit.textContent = 'Wird gesendet …';
            status.className = 'form-status';
            status.textContent = '';

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: (document.getElementById('name') as HTMLInputElement).value,
                  email: (document.getElementById('email') as HTMLInputElement).value,
                  phone: (document.getElementById('phone') as HTMLInputElement).value,
                  type: (document.getElementById('type') as HTMLSelectElement).value,
                  message: (document.getElementById('message') as HTMLTextAreaElement).value,
                  lang: 'de',
                }),
              });

              if (res.ok) {
                status.className = 'form-status form-status--success';
                status.textContent = 'Vielen Dank! Ihre Anfrage wurde gesendet. Ilian meldet sich in Kürze.';
                form.reset();
                submit.textContent = 'Anfrage gesendet ✓';
              } else {
                status.className = 'form-status form-status--error';
                status.textContent = 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut oder kontaktieren Sie uns per E-Mail.';
                submit.disabled = false;
                submit.textContent = 'Anfrage senden';
              }
            } catch {
              status.className = 'form-status form-status--error';
              status.textContent = 'Verbindungsfehler. Bitte prüfen Sie Ihre Internetverbindung oder schreiben Sie uns direkt per E-Mail.';
              submit.disabled = false;
              submit.textContent = 'Anfrage senden';
            }
          });
        </script>
      </div>

      <div class="contact-info-col">
        <div class="section-label">// Direkt kontaktieren</div>
        <h2 class="section-heading">Kontakt&shy;daten.</h2>

        <div class="contact-detail-block">
          <div class="contact-detail-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.84a16 16 0 0 0 6.06 6.06l1.14-.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.01z"/></svg>
          </div>
          <div>
            <div class="contact-detail-label">Telefon</div>
            <a href="tel:+4917630310142" class="contact-detail-value">+49 (0)176 / 303 101 42</a>
          </div>
        </div>
        <div class="contact-detail-block">
          <div class="contact-detail-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <div class="contact-detail-label">E-Mail</div>
            <a href="mailto:actionartist@web.de" class="contact-detail-value">actionartist@web.de</a>
          </div>
        </div>
        <div class="contact-detail-block">
          <div class="contact-detail-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="contact-detail-label">Adresse</div>
            <div class="contact-detail-value">Deubner Str 40c<br />01159 Dresden<br />Deutschland</div>
          </div>
        </div>

        <div class="sedcard-download-block">
          <div class="section-label" style="margin-bottom: 16px;">// Sedcard &amp; Vita</div>
          <p class="body-text" style="font-size: 14px; margin-bottom: 20px;">
            Laden Sie Ilians Sedcard und Vita als PDF herunter — mit Fotos, Körperdaten, Skills und vollständiger Produktionshistorie.
          </p>
          <a href="/pdfs/setcard.pdf" download class="btn-outline-orange" style="display: block; text-align: center; padding: 14px 24px;">↓ Sedcard &amp; Vita PDF herunterladen</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
.page-hero {
  min-height: 40vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 80px var(--page-pad) 56px;
  position: relative;
  background: linear-gradient(175deg, #0e0e0e 0%, #1c0c04 55%, #0e0e0e 100%);
  border-bottom: 1px solid var(--border);
}
.page-hero-content { position: relative; z-index: 2; }
.page-hero-title {
  font-family: var(--font-serif);
  font-size: clamp(48px, 7vw, 96px);
  font-weight: bold;
  line-height: 0.9;
  letter-spacing: -2px;
  color: var(--white);
  margin-bottom: 20px;
}
.page-hero-sub {
  font-family: var(--font-sans);
  font-size: 13px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--gray);
}
.contact-main-section {
  padding: var(--section-pad) var(--page-pad);
  background: var(--black);
  border-top: 1px solid var(--border);
}
.contact-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 80px;
  align-items: start;
}
.contact-form { display: flex; flex-direction: column; gap: 20px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-group { display: flex; flex-direction: column; gap: 8px; }
.form-label {
  font-family: var(--font-sans);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gray);
  font-weight: 600;
}
.form-input {
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--white);
  font-family: var(--font-sans);
  font-size: 15px;
  padding: 14px 16px;
  width: 100%;
  outline: none;
  transition: border-color 0.2s;
}
.form-input:focus { border-color: var(--orange); }
.form-input option { background: var(--card); }
.form-textarea { min-height: 140px; resize: vertical; }
.contact-info-col { display: flex; flex-direction: column; gap: 0; }
.contact-detail-block {
  display: flex;
  gap: 20px;
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
  align-items: center;
}
.contact-detail-icon {
  color: var(--orange);
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact-detail-label {
  font-family: var(--font-sans);
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--orange);
  margin-bottom: 6px;
}
.contact-detail-value {
  font-family: var(--font-sans);
  font-size: 16px;
  color: var(--white);
  line-height: 1.5;
}
a.contact-detail-value:hover { color: var(--orange); }
.sedcard-download-block {
  margin-top: 40px;
  padding: 28px;
  background: var(--card);
  border: 1px solid var(--border);
}
.form-status {
  display: none;
  padding: 14px 16px;
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.5;
}
.form-status--success {
  display: block;
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.3);
  color: #4ade80;
}
.form-status--error {
  display: block;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  color: #f87171;
}
</style>
