---
/**
 * prompt: place download vita section on top on all routes; Ilian Simeonow home button on the left
 */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getContactNameParts } from '../data/siteContact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { given, family } = getContactNameParts();
const homeHref = lang === 'de' ? '/' : '/en/';
const pdfHref = lang === 'de' ? '/pdfs/setcard.pdf' : '/pdfs/setcard-en.pdf';
---

<div class="sedcard-bar">
  <a href={homeHref} class="sedcard-bar-home">{given} <span class="sedcard-bar-home-accent">{family}</span></a>
  <div class="sedcard-bar-actions">
    <span class="sedcard-bar-text">{t('sedcard.text')}</span>
    <a href={pdfHref} download class="btn-outline-orange">{t('sedcard.btn')}</a>
  </div>
</div>
