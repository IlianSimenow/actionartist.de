---
/**
 * prompt: place download vita section on top on all routes; full nav below hero
 * prompt: improve scrolling behaviour & feeling — add IntersectionObserver-driven
 *         section reveals (CSS handles the actual animation in global.css §22)
 * prompt: im footer der website adde eine kleine unauffällige aber moderne und
 *         irgendwie doch auffällige line "Made with Brain (electric brain icon) by
 *         Benedikt Sterra (ref botworld.cloud) and Prateek Rohilla
 *         (ref: https://ptkr.eu/)"
 */
import '../styles/global.css';
import { useTranslations, getAlternateLangUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import NavMenu from '../components/NavMenu.astro';
import SedcardBar from '../components/SedcardBar.astro';
import { getContactNameParts } from '../data/siteContact';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  heroImage?: string;
  /** @deprecated Use page-hero--* modifier classes in global.css instead */
  heroImagePosition?: string;
}

const { lang, title, description = '', heroImage, heroImagePosition } = Astro.props;
const t = useTranslations(lang);
const { given: contactGiven, family: contactFamily } = getContactNameParts();
const alternateLang: Lang = lang === 'de' ? 'en' : 'de';
const alternateUrl = getAlternateLangUrl(Astro.url, alternateLang);

const base = lang === 'de' ? '' : `/${lang}`;
const bioHref    = lang === 'de' ? `${base}/biographie/`  : `${base}/biography/`;
const galleryHref = lang === 'de' ? `${base}/galerie/`    : `${base}/gallery/`;
const partnerHref = lang === 'de' ? `${base}/partner/`    : `${base}/partners/`;
const contactHref = lang === 'de' ? `${base}/kontakt/`    : `${base}/contact/`;
const impHref     = lang === 'de' ? `${base}/impressum/`  : `${base}/legal-notice/`;

const wissenBase  = lang === 'de' ? `${base}/wissen/` : `${base}/knowledge/`;
const w1 = lang === 'de' ? `${wissenBase}geschichte-stuntman/` : `${wissenBase}history-stuntman/`;
const w2 = lang === 'de' ? `${wissenBase}wie-werde-ich-stuntman/` : `${wissenBase}how-to-stuntman/`;
const w3 = lang === 'de' ? `${wissenBase}geschichte-artistik/` : `${wissenBase}history-circus-arts/`;
const w4 = lang === 'de' ? `${wissenBase}wie-werde-ich-artist/` : `${wissenBase}how-to-artist/`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
  <link rel="manifest" href="/favicon/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="alternate" hreflang={lang} href={Astro.url.href} />
  <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
  {heroImage && (
    <style set:html={`.page-hero { --hero-bg: url('${heroImage}'); }`}></style>
  )}
</head>
<body>

  {/* Sedcard bar — download vita, top of every route */}
  <SedcardBar lang={lang} />

  {/* prompt: burger menu — backdrop at body level so outer press closes drawer below toggle */}
  <div class="nav-backdrop" id="navBackdrop" hidden></div>

  <!-- Mobile only: logo + hamburger; hidden on desktop web view -->
  <nav class="nav nav--top" id="siteNav">
    <a href={lang === 'de' ? '/' : '/en/'} class="nav-logo">{contactGiven} <span class="nav-logo-accent">{contactFamily}</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <slot />

  <!-- Full nav — placed after hero via inline script -->
  <div class="nav-sub" id="navSub" hidden>
    <NavMenu lang={lang} />
  </div>

  <footer class="footer">
    <div class="footer-top">
      <div>
        <div class="footer-brand-name">{contactGiven} <span class="footer-brand-name-accent">{contactFamily}</span></div>
        <p class="footer-brand-text">{t('footer.brand.text')}</p>
      </div>
      <div>
        <div class="footer-col-title">{t('footer.col.nav')}</div>
        <ul class="footer-links-list">
          <li><a href={bioHref}>{t('nav.bio')}</a></li>
          <li><a href={`${base}/skills/`}>{lang === 'de' ? 'Skills & Fertigkeiten' : 'Skills'}</a></li>
          <li><a href={`${base}/credits/`}>{lang === 'de' ? 'Credits & Referenzen' : 'Credits & References'}</a></li>
          <li><a href={galleryHref}>{t('nav.galerie')}</a></li>
          <li><a href={`${base}/video/`}>{t('nav.video')}</a></li>
          <li><a href={partnerHref}>{t('nav.partner')}</a></li>
          <li><a href={contactHref}>{t('nav.kontakt')}</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-col-title">{t('footer.col.wissen')}</div>
        <ul class="footer-links-list">
          <li><a href={w1}>{lang === 'de' ? 'Geschichte des Stuntman' : 'History of Stunts'}</a></li>
          <li><a href={w2}>{lang === 'de' ? 'Wie werde ich Stuntman?' : 'How to Become a Stuntman?'}</a></li>
          <li><a href={w3}>{lang === 'de' ? 'Geschichte der Artistik' : 'History of Circus Arts'}</a></li>
          <li><a href={w4}>{lang === 'de' ? 'Wie werde ich Artist?' : 'How to Become an Artist?'}</a></li>
        </ul>
        <div class="footer-col-title" style="margin-top: 24px;">{lang === 'de' ? 'Workshops' : 'Workshops'}</div>
        <ul class="footer-links-list">
          <li><a href={lang === 'de' ? `${base}/workshops/fechten/` : `${base}/workshops/fencing/`}>{lang === 'de' ? 'Workshop Fechten' : 'Stage Fencing'}</a></li>
          <li><a href={`${base}/workshops/stunt/`}>{lang === 'de' ? 'Workshop Stunt' : 'Stunt Workshop'}</a></li>
          <li><a href={lang === 'de' ? `${base}/workshops/kinderzirkus/` : `${base}/workshops/youth-circus/`}>{lang === 'de' ? 'Workshop Kinderzirkus' : 'Youth Circus'}</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-col-title">{t('footer.col.legal')}</div>
        <ul class="footer-links-list">
          <li><a href={lang === 'de' ? '/pdfs/setcard.pdf' : '/pdfs/setcard-en.pdf'} download>{t('sedcard.btn')}</a></li>
          <li><a href={impHref}>{t('footer.impressum')}</a></li>
          <li><a href={`${impHref}#datenschutz`}>{t('footer.datenschutz')}</a></li>
          <li><a href="/sitemap-index.xml">{t('footer.sitemap')}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">{t('footer.copy')}</div>
      <div class="footer-profiles">
        <a href="https://www.imdb.com/name/nm4125422/" target="_blank" rel="noopener" title="Ilian Simeonow on IMDb" class="footer-profile-link">
          <img src="/images/imdb.png" alt="IMDb" class="footer-profile-img" />
        </a>
        <a href="https://www.crew-united.com/?bio=96713" target="_blank" rel="noopener" title="Ilian Simeonow on Crew United" class="footer-profile-link">
          <img src="/images/crew-united.svg" alt="Crew United" class="footer-profile-img footer-profile-img--crew" />
        </a>
        <a href="https://de.wikipedia.org/wiki/Ilian_Simeonow" target="_blank" rel="noopener" title="Ilian Simeonow — Wikipedia" class="footer-profile-link footer-profile-link--wiki">
          Wikipedia
        </a>
      </div>
      <div class="footer-legal">
        <a href={impHref}>{t('footer.impressum')}</a>
        <a href={`${impHref}#datenschutz`}>{t('footer.datenschutz')}</a>
        <a href="/sitemap-index.xml">{t('footer.sitemap')}</a>
      </div>
    </div>
    {/* prompt: Made with Brain — flash icon; author names normal weight */}
    <div class="footer-credits">
      <span class="footer-credits-text">Made with Brain</span>
      {/* Inline cyber-flash SVG: gradient fill + glow, animated pulse via CSS */}
      <svg class="footer-credits-flash" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="cyberFlashGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#00e5ff" />
            <stop offset="55%"  stop-color="#b14bff" />
            <stop offset="100%" stop-color="#ff2bd6" />
          </linearGradient>
        </defs>
        {/* Lightning bolt — electric flash motif */}
        <path d="M13.5 2.5L5.5 13.5H11l-1.5 8.5 9.5-11.5H13l1.5-7.5z"
              fill="url(#cyberFlashGrad)" stroke="#00e5ff" stroke-width="0.4" stroke-linejoin="round" />
        {/* Spark accents at bolt tips */}
        <circle cx="13.5" cy="3"  r="0.8" fill="#00e5ff" />
        <circle cx="10"   cy="21" r="0.8" fill="#ff2bd6" />
      </svg>
      <span class="footer-credits-text">by</span>
      {/* Author 1 — Benedikt Sterra → botworld.cloud */}
      <a class="footer-credits-link" href="https://botworld.cloud" target="_blank" rel="noopener noreferrer" title="botworld.cloud">
        Benedikt Sterra
      </a>
      <span class="footer-credits-text">and</span>
      {/* Author 2 — Prateek Rohilla → ptkr.eu */}
      <a class="footer-credits-link" href="https://ptkr.eu/" target="_blank" rel="noopener noreferrer" title="ptkr.eu">
        Prateek Rohilla
      </a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      const nav = document.getElementById('siteNav');
      const toggle = document.getElementById('navToggle');
      const drawerClose = document.getElementById('navDrawerClose');
      const links = document.getElementById('navLinks');
      const backdrop = document.getElementById('navBackdrop');
      const navSub = document.getElementById('navSub');

      // Place full nav directly below hero / page-hero
      function getNavAnchor() {
        return document.querySelector('.hero') || document.querySelector('.page-hero');
      }

      /* prompt: burger menu — always reveal nav shell; placement below hero is optional */
      function placeNav() {
        if (!navSub) return;

        var anchor = getNavAnchor();
        if (anchor && navSub.previousElementSibling !== anchor) {
          anchor.parentNode.insertBefore(navSub, anchor.nextSibling);
        }
        navSub.hidden = false;
      }

      placeNav();

      // Scroll-shrink mobile top bar only (desktop web view hides it)
      let ticking = false;
      const onScroll = () => {
        if (!nav) return;
        if (window.innerWidth > 1100) {
          nav.classList.remove('nav--scrolled');
          document.body.classList.remove('nav-top--scrolled');
          ticking = false;
          return;
        }
        if (window.scrollY > 24) {
          nav.classList.add('nav--scrolled');
          document.body.classList.add('nav-top--scrolled');
        } else {
          nav.classList.remove('nav--scrolled');
          document.body.classList.remove('nav-top--scrolled');
        }
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      }, { passive: true });
      onScroll();

      // prompt: burger opens drawer; in-slider close button + backdrop close it
      const closeMenu = () => {
        document.body.classList.remove('nav-open');
        toggle && toggle.setAttribute('aria-expanded', 'false');
        backdrop && (backdrop.hidden = true);
      };
      const openMenu = () => {
        document.body.classList.add('nav-open');
        toggle && toggle.setAttribute('aria-expanded', 'true');
        backdrop && (backdrop.hidden = false);
      };
      toggle && toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!document.body.classList.contains('nav-open')) openMenu();
      });
      drawerClose && drawerClose.addEventListener('click', (e) => {
        e.stopPropagation();
        closeMenu();
      });
      if (backdrop) {
        backdrop.addEventListener('click', closeMenu);
        backdrop.addEventListener('touchend', (e) => {
          e.preventDefault();
          closeMenu();
        });
      }
      document.addEventListener('click', (e) => {
        if (!document.body.classList.contains('nav-open')) return;
        if (toggle && toggle.contains(e.target)) return;
        if (drawerClose && drawerClose.contains(e.target)) return;
        if (links && links.contains(e.target)) return;
        closeMenu();
      });
      links && links.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
      window.addEventListener('resize', () => { if (window.innerWidth > 1100) closeMenu(); });

      /* ──────────────────────────────────────────────────────────────
         Scroll-reveal: fade & rise content sections as they enter view.
         Skip the hero/page-hero (above the fold, must render instantly)
         and respect the user's prefers-reduced-motion setting.
         The visual transition itself lives in global.css §22.
         ────────────────────────────────────────────────────────────── */
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        // Tag every section except the hero(s) — they're already visible on load
        var revealTargets = document.querySelectorAll(
          'main section, body > section, .about-section, .productions-section, ' +
          '.credits-section, .skills-section, .gallery-section, .video-section, ' +
          '.partners-section, .wissen-section, .contact-section, .footer'
        );
        revealTargets.forEach(function (el) {
          if (el.classList.contains('hero') || el.classList.contains('page-hero')) return;
          el.classList.add('reveal-on-scroll');
        });

        // Trigger slightly before the section is fully on screen — feels organic
        var revealObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

        revealTargets.forEach(function (el) {
          if (el.classList.contains('reveal-on-scroll')) revealObserver.observe(el);
        });
      }
    })();
  </script>

</body>
</html>
