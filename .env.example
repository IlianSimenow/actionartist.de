RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=actionartist@web.de
# While using onboarding@resend.dev, set delivery to your Resend account email
RESEND_DELIVERY_EMAIL=your-resend-account@email.com
RESEND_FROM_EMAIL=Kontakt <onboarding@resend.dev>
